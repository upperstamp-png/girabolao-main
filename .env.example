# Frontend (Vite)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua-anon-key

# Edge Functions (configurar no Supabase Dashboard > Edge Functions > Secrets)
# Football-Data.org — jogos, tabelas, elencos (10 req/min)
FOOTBALL_DATA_API_TOKEN=sua-chave-football-data

# API-Football (api-sports.io) — placar ao vivo e stats (100 req/dia)
API_FOOTBALL_KEY=sua-chave-api-football

# TheSportsDB e StatsBomb nao precisam de chave (uso publico)
